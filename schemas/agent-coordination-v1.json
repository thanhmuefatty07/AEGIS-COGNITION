{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis-agent-coordination-v1",
  "title": "AEGIS in-process agent coordination envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "message_kind",
    "run_id",
    "sender_id",
    "recipient_id",
    "task_id",
    "parent_task_id",
    "attempt_id",
    "idempotency_key",
    "payload",
    "artifact_refs",
    "token_budget",
    "deadline_ms",
    "message_hash"
  ],
  "properties": {
    "schema": {"const": "aegis-agent-message-v1"},
    "message_kind": {"enum": ["TASK_REQUEST", "TASK_RESULT"]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sender_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recipient_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "integer", "minimum": 1},
    "parent_task_id": {"type": ["integer", "null"], "minimum": 1},
    "attempt_id": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "payload": {"type": "object"},
    "artifact_refs": {"type": "array", "maxItems": 64},
    "token_budget": {"type": ["integer", "null"], "minimum": 1},
    "deadline_ms": {"type": ["integer", "null"], "minimum": 1},
    "message_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
